{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Captain Mission Brief",
  "description": "Structure only; authority, truth, readiness, and evidence require semantic verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "revision", "updated_at", "status", "objective", "owner", "scope", "sources", "facts", "capabilities", "dependencies", "authority", "acceptance_criteria", "deliverables"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "mission_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["draft", "ready", "running", "awaiting_input", "awaiting_authorization", "blocked", "failed", "completed", "cancelled"]},
    "objective": {"$ref": "#/$defs/text"},
    "owner": {"enum": ["Captain", "Mailrun", "Opportunity Fit", "Resume Studio", "Application Run", "Tracker Steward", "Interview Prep", "Sitrep"]},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {"included": {"$ref": "#/$defs/nonemptyTexts"}, "excluded": {"$ref": "#/$defs/texts"}}
    },
    "sources": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "reference", "kind", "state"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["user_statement", "file", "connector", "web", "prior_result"]},
          "state": {"enum": ["unchecked", "available", "unavailable", "stale"]}
        }
      }
    },
    "facts": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["statement", "source_ids", "verification"],
        "properties": {
          "statement": {"$ref": "#/$defs/text"},
          "source_ids": {"$ref": "#/$defs/texts"},
          "verification": {"enum": ["user_confirmed", "observed", "unverified", "stale"]}
        }
      }
    },
    "capabilities": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "required", "state"],
        "properties": {
          "name": {"$ref": "#/$defs/text"}, "required": {"type": "boolean"},
          "state": {"enum": ["unchecked", "available", "unavailable"]}
        }
      }
    },
    "dependencies": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reference", "condition", "state"],
        "properties": {
          "reference": {"$ref": "#/$defs/text"}, "condition": {"$ref": "#/$defs/text"},
          "state": {"enum": ["pending", "satisfied", "failed"]}
        }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["request_reference", "allowed_green_actions", "grants", "proposed_red_actions"],
      "properties": {
        "request_reference": {"$ref": "#/$defs/text"},
        "allowed_green_actions": {"$ref": "#/$defs/texts"},
        "grants": {"type": "array", "items": {"$ref": "#/$defs/grant"}},
        "proposed_red_actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "condition", "verification_method"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "condition": {"$ref": "#/$defs/text"},
          "verification_method": {"$ref": "#/$defs/text"}
        }
      }
    },
    "deliverables": {"$ref": "#/$defs/nonemptyTexts"},
    "open_questions": {"$ref": "#/$defs/texts"},
    "checkpoint_reference": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "nonemptyTexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "action", "destination", "data_references", "scope"],
      "properties": {
        "action_id": {"$ref": "#/$defs/text"}, "action": {"$ref": "#/$defs/text"},
        "destination": {"$ref": "#/$defs/text"}, "data_references": {"$ref": "#/$defs/nonemptyTexts"},
        "scope": {"$ref": "#/$defs/text"}
      }
    },
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_id", "approved_action", "user_evidence_reference", "state"],
      "properties": {
        "grant_id": {"$ref": "#/$defs/text"},
        "approved_action": {"$ref": "#/$defs/action"},
        "user_evidence_reference": {"$ref": "#/$defs/text"},
        "state": {"enum": ["active", "revoked", "expired"]},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
